      "id": "598b45f1-e327-4fa7-a230-083cbc75d82e",
      "name": "Check Busy Slots",
      "type": "n8n-nodes-base.airtableTool",
      "typeVersion": 2.2,
      "position": [
        2080,
        416
      ],
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Returns appointments that are already booked on a given date (Yerevan time). Always call it before Save Booking. Each visit lasts 1 hour.",
        "resource": "record",
        "operation": "search",
        "authentication": "airtableTokenApi",
        "base": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_BASE_ID"
        },
        "table": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_AIRTABLE_BOOKINGS_TABLE_ID"
        },
        "filterByFormula": "=AND(DATETIME_FORMAT(SET_TIMEZONE({Appointment At}, 'Asia/Yerevan'), 'YYYY-MM-DD') = '{{ $fromAI('date', 'Date to check in YYYY-MM-DD format') }}', {Status} != 'cancelled')",
        "returnAll": true,
        "options": {
          "fields": [
            "Appointment At",
            "Service",
            "Status"
          ]
        }
      }
    }
