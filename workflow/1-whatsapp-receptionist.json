        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Name": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('name', 'Client full name') }}",
            "Phone": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('phone', 'Client phone number with country code, e.g. +37491123456') }}",
            "Service": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('service', 'Service the client wants, e.g. professional cleaning') }}",
            "Appointment At": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('appointment_at', 'Appointment date and time in ISO 8601 with Yerevan offset, e.g. 2026-11-24T15:00:00+04:00') }}",
            "Status": "booked",
            "Language": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('language', 'Language the client writes in: hy, ru or en') }}",
            "Notes": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('notes', 'Short note: anything important the client said, or empty') }}"
          },
          "matchingColumns": [],
